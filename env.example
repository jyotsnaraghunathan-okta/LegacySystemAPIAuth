# Copy to .env for local development. .env is gitignored.

# Credentials as a JSON object mapping username -> password.
# Required in any real deployment; main.py uses insecure defaults without it.
API_USERS={"svc_agent":"local-dev-password","analyst":"local-dev-password-2"}

# Session lifetime in seconds.
SESSION_TTL_SECONDS=1800

# true: each authenticated request extends the expiry window (sliding session).
# false: the session expires a fixed interval after login.
SLIDING_EXPIRY=true

# Session cookie name. Legacy platforms commonly use JSESSIONID or ASP.NET_SessionId.
SESSION_COOKIE_NAME=SESSIONID

# Set false for local http:// testing so the browser will store the cookie.
COOKIE_SECURE=false

# Realm shown in the WWW-Authenticate challenge.
BASIC_AUTH_REALM=Legacy Platform

# Local port. Render injects PORT automatically.
PORT=8000


# --- MCP server (mcp_server.py) ---------------------------------------------
# The MCP server expects an upstream gateway to inject the vaulted credential
# as an 'Authorization: Basic' header. It stores no credentials itself.

# Platform root. Point this at a deployed instance to wrap a remote platform.
PLATFORM_BASE_URL=http://localhost:8000

# Request timeout. Keep this generous when the platform is on a free tier
# that sleeps when idle — the first request after a sleep can take ~60s.
HTTP_TIMEOUT_SECONDS=90

# Local development fallback ONLY. Used when no Authorization header is
# injected, which is the case over stdio. LEAVE THESE UNSET behind a gateway:
# setting them stores a credential in this process, which is exactly what the
# injection model exists to avoid.
# PLATFORM_USERNAME=svc_agent
# PLATFORM_PASSWORD=local-dev-password
