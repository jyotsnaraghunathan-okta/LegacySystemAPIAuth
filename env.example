# Copy to .env for local development. .env is gitignored.

# Credentials as a JSON object mapping username -> password.
# Required in any real deployment; main.py uses insecure defaults without it.
API_USERS={"svc_agent":"local-dev-password","analyst":"local-dev-password-2"}

# Session lifetime in seconds.
SESSION_TTL_SECONDS=1800

# true: each authenticated request extends the expiry window (sliding session).
# false: the session expires a fixed interval after login.
SLIDING_EXPIRY=true

# Session cookie name. Legacy platforms commonly use JSESSIONID or ASP.NET_SessionId.
SESSION_COOKIE_NAME=SESSIONID

# Set false for local http:// testing so the browser will store the cookie.
COOKIE_SECURE=false

# Realm shown in the WWW-Authenticate challenge.
BASIC_AUTH_REALM=Legacy Platform

# Local port. Render injects PORT automatically.
PORT=8000
