        },
        "url": { "raw": "{{mcpUrl}}", "host": ["{{mcpUrl}}"] },
        "description": "Which platform identity the call authenticated as. Expect auth_method \"basic\" and session_id null — the server forwards credentials rather than holding a session."
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "const r = JSON.parse(pm.collectionVariables.get('lastResult') || '{}');",
              "const c = r.result && r.result.content;",
              "if (c && c.length) {",
              "  const p = JSON.parse(c[0].text);",
              "  pm.test('platform saw Basic auth', () => pm.expect(p.auth_method).to.eql('basic'));",
              "  pm.test('no session was minted', () => pm.expect(p.session_id).to.be.null);",
              "}"
            ]
          }
        }
      ]
    },
