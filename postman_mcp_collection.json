    {
      "name": "15 — Bearer token instead of Basic (expect failure)",
      "request": {
        "auth": { "type": "noauth" },
        "method": "POST",
        "header": [
          { "key": "Content-Type", "value": "application/json" },
          { "key": "Accept", "value": "application/json, text/event-stream" },
          {
            "key": "Authorization",
            "value": "Bearer eyJhbGciOiJSUzI1NiIsInR5cCI6IkpXVCJ9.not.a.real.token"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"jsonrpc\": \"2.0\",\n  \"id\": 14,\n  \"method\": \"tools/call\",\n  \"params\": {\n    \"name\": \"list_accounts\",\n    \"arguments\": {}\n  }\n}"
        },
        "url": { "raw": "{{mcpUrl}}", "host": ["{{mcpUrl}}"] },
        "description": "Reproduces the gateway misconfiguration seen in practice: the gateway relays the agent's own Bearer token instead of exchanging it for the vaulted credential.\n\nThe server rejects it with an explicit scheme-mismatch message rather than forwarding it, so the failure names the real cause instead of surfacing as an opaque 401 from the platform."
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "const r = JSON.parse(pm.collectionVariables.get('lastResult') || '{}');",
              "const c = r.result && r.result.content;",
              "if (c && c.length) {",
              "  const e = (JSON.parse(c[0].text).error || '').toLowerCase();",
              "  pm.test('names the offending scheme', () => pm.expect(e).to.include('bearer'));",
              "  pm.test('says the platform wants Basic', () => pm.expect(e).to.include('basic'));",
              "  pm.test('tells the gateway to exchange the token', () => pm.expect(e).to.include('exchange'));",
              "}"
            ]
          }
        }
      ]
    }
  ]
}
