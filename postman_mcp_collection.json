    {
      "name": "11 — list_platform_sessions as reader (expect failure)",
      "request": {
        "auth": {
          "type": "basic",
          "basic": [
            { "key": "username", "value": "{{readerUsername}}", "type": "string" },
            { "key": "password", "value": "{{readerPassword}}", "type": "string" }
          ]
        },
        "method": "POST",
        "header": [
          { "key": "Content-Type", "value": "application/json" },
          { "key": "Accept", "value": "application/json, text/event-stream" }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"jsonrpc\": \"2.0\",\n  \"id\": 10,\n  \"method\": \"tools/call\",\n  \"params\": {\n    \"name\": \"list_platform_sessions\",\n    \"arguments\": {}\n  }\n}"
        },
        "url": { "raw": "{{mcpUrl}}", "host": ["{{mcpUrl}}"] },
        "description": "The authorization demo. Same tool and same MCP server as request 10, but this one overrides collection auth to inject the reader credential — and the platform refuses it.\n\nThe refusal states that authentication succeeded and authorization did not, because the two need different fixes. Nothing in the MCP server implements this; the injected identity determines it."
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "const r = JSON.parse(pm.collectionVariables.get('lastResult') || '{}');",
              "const c = r.result && r.result.content;",
              "if (c && c.length) {",
              "  const p = JSON.parse(c[0].text);",
              "  pm.test('refusal is about authorization, not authentication', () => {",
              "    pm.expect((p.error || '').toLowerCase()).to.include('authorization');",
              "  });",
              "}"
            ]
          }
        }
      ]
    },
